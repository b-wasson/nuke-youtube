{
    "name": "nuke youtube",
    "description": "removes all functions of youtube",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
      "default_popup": "main.html",
      "default_icon": "nuke.jpg"
    },
    
  "declarative_net_request" : {
        "rule_resources" : [{
        "id": "1",
        "enabled": true,
        "path": "rules.json"
        }]
    },
  
    "permissions": [
        "declarativeNetRequest",
        "declarativeNetRequestFeedback"
    ],

    "host_permissions": [
        "https://*.youtube.com/*",
        "http://*.google.com/*"
    ],


    "content_scripts": [
        {
          "matches": ["https://*.youtube.com/*"],
          "js": ["content.js"]
        }
      ]
      
  }

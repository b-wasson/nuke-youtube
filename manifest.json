{
    "name": "nuke youtube",
    "description": "removes all functions of youtube",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "popup.html",
        "default_icon": "nuke.png"
    },
    "icons": {
        "16": "nuke.png",
        "48": "nuke.png",
        "128": "nuke.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "tabs",
        "webNavigation",
        "storage"
    ],
    "host_permissions": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://*.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
    ]
}
